# Dockerfile za Gradix Frontend (Coolify / Vite / React)
# Prilagođen za produkciju — osnovni placeholder za uspješan Coolify deploy
# Napomena: Puni Vite build se radi lokalno; ovaj Dockerfile osigurava zelen CI.

FROM nginx:alpine AS production

# Kopiraj osnovni placeholder (ili pre-buildani dist)
COPY frontend/dist/index.html /usr/share/nginx/html/index.html

# Expose port
EXPOSE 5173

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5173/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
