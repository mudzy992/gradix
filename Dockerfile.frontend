# Dockerfile za Gradix Frontend (Coolify / Vite / React)
# Prilagođen za produkciju — standardni build + nginx statički server

FROM node:22-alpine AS builder
WORKDIR /app

# Kopiraj package fajlove i instaliraj sve zavisnosti (dev + dependencies)
COPY package*.json ./
RUN npm ci

# Kopiraj sav source kod i izgradi aplikaciju
COPY . .
ENV PATH=/app/node_modules/.bin:$PATH
RUN npm run build

# Produkcijska slika — nginx za statičke fajlove
FROM nginx:alpine AS production

# Kopiraj buildane statičke fajlove iz builder faze
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port
EXPOSE 5173

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5173/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
