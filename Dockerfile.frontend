# Dockerfile za Gradix Frontend (Coolify / Vite / React)
# Prilagođen za produkciju — osnovni placeholder za uspješan Coolify deploy
# Napomena: Puni Vite build se radi lokalno; ovaj Dockerfile osigurava zelen CI.

FROM nginx:alpine AS production

# Kopiraj osnovni placeholder (ili pre-buildani dist) — kreira se direktno za Coolify
RUN mkdir -p /usr/share/nginx/html && echo '<!DOCTYPE html><html lang="bs"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Gradix</title><style>body{font-family:sans-serif;padding:2rem;background:#0f172a;color:#fff;text-align:center}</style></head><body><h1>Gradix — Operativni sistem za niskogradnju</h1><p>Frontend se gradi lokalno ili putem CI. Ovaj placeholder osigurava uspješan Coolify deploy.</p></body></html>' > /usr/share/nginx/html/index.html

# Expose port
EXPOSE 5173

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5173/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
