# Gradix frontend — nginx konfiguracija (envsubst template)
#
# `nginx:alpine` image zamjenjuje ${BACKEND_URL} stvarnom vrijednošću env
# varijable pri startu kontejnera (samo varijable koje postoje u okruženju).

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Limit za upload fajlova (backend dozvoljava do 10 MB, ostavljamo rezervu).
    client_max_body_size 20m;

    # Ne otkrivaj verziju nginx-a u odgovorima/error stranicama.
    server_tokens off;

    # Sigurnosni headeri (backend šalje Helmet header-e za /api odgovore).
    # VAŽNO: nginx `add_header` u dubljem bloku PONIŠTAVA sve naslijeđene headere —
    # zato ih svaki `location` koji ima svoj `add_header` mora ponoviti (vidi /assets/
    # i =/index.html). Guard `check:image` to provjerava.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # CSP: `CSP_API_ORIGIN` je origin backenda kad se API servira sa **drugog domena**
    # (npr. https://api.gradix.ba101.top) — D-041. Kad je prazno, CSP je strogo jednozemljisni
    # (`'self'`). `ws:`/`wss:` pokrivaju Socket.IO na bilo kojem hostu; `img-src` dobija isti
    # origin jer se logotipi/fajlovi prikazuju preko `<img src="https://api…/api/files">`.
    # `'unsafe-inline'` je samo za stilove; skripte su strogo `'self'`.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${CSP_API_ORIGIN}; font-src 'self' data:; connect-src 'self' ws: wss: ${CSP_API_ORIGIN}; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ---- API ----
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 20m;
    }

    # ---- WebSocket (Socket.IO) ----
    location /socket.io/ {
        proxy_pass ${BACKEND_URL}/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # ---- Buildovani asseti (hashirani nazivi) ----
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # Ponovljeni sigurnosni headeri — `add_header` iznad se ne nasljeđuje
        # kada ovaj blok ima svoj `add_header`.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${CSP_API_ORIGIN}; font-src 'self' data:; connect-src 'self' ws: wss: ${CSP_API_ORIGIN}; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
        try_files $uri =404;
    }

    # ---- SPA fallback (react-router) ----
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html se ne kešira — da deploy odmah bude vidljiv
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${CSP_API_ORIGIN}; font-src 'self' data:; connect-src 'self' ws: wss: ${CSP_API_ORIGIN}; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
    }
}
