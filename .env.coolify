# .env.coolify — Gradix produkcijska konfiguracija (Coolify)
# Sve tajne moraju biti zamijenjene stvarnim vrijednostima prije deploy-a.

# === PostgreSQL (EKSTERNA — već postoji u Dockeru / Coolify okruženju) ===
# Ova aplikacija NE uključuje `db` servis u docker-compose — koristi postojeću bazu.
POSTGRES_DB=gradix
POSTGRES_USER=gradix_user
POSTGRES_PASSWORD=gradix_password
# TLS CA cert mapiran sa hosta: /data/coolify/ssl/coolify-ca.crt
# DATABASE_URL se definiše ispod — pokazuje na eksternu PostgreSQL instancu

# === Backend (NestJS) ===
NODE_ENV=production
PORT=3000

# PostgreSQL konekcija sa TLS verifikacijom CA cert-a
DATABASE_URL="postgresql://gradix_user:gradix_password@postgres.external:5432/gradix?sslmode=verify-ca&sslrootcert=/etc/ssl/certs/coolify-ca.crt"

# JWT tajne — MINIMUM 32 ZNAKA za produkciju!
JWT_ACCESS_SECRET="change-me-access-secret-min-32-characters-replace-this"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-characters-replace-this"

# MinIO (objektno skladište)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gradix

# CORS — zamijeni sa stvarnim Coolify domenama
CORS_ORIGIN="https://gradix.local,https://app.gradix.local"

# Seed lozinka za demo podatke — PROMIJENITI za produkciju!
SEED_PASSWORD="GradixSeed1"

# TLS CA cert za PostgreSQL klijent (unutar kontejnera)
PGSSLROOTCERT=/etc/ssl/certs/coolify-ca.crt
PGSSLMODE=verify-ca

# === Frontend (Vite) ===
VITE_API_URL=http://gradix-backend:3000

# === Redis (EKSTERNI / GLOBALNI — već postoji) ===
# Gradix v1 ne koristi Redis (`Nema Redis/BullMQ` u v1), ali za buduće faze i Coolify:
REDIS_HOST=redis.global
REDIS_PORT=6379
REDIS_PASSWORD=gradixwork
REDIS_TLS_CA_FILE=/etc/ssl/redis/redis-ca.crt
REDIS_PREFIX=gradix:queue:
