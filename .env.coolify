# Gradix — Coolify produkcijska konfiguracija (predložak)
#
# Ovo NIJE `.env` koji Docker Compose automatski čita — u Coolify se varijable
# unose kroz UI (Environment Variables) za dati resource. Fajl služi kao
# popis i predložak vrijednosti.
#
# Detaljna uputstva: docs/INFRASTRUCTURE.md
# NE COMMITOVATI stvarne tajne u ovaj fajl.

# === PostgreSQL (EKSTERNA baza — nije dio docker-compose.yml) ===
DATABASE_URL="postgresql://gradix_user:gradix_password@postgres:5432/gradix?schema=public"

# Ako baza zahtijeva TLS sa provjerom CA certifikata:
#   1) u Coolify postavi Persistent Storage za backend:
#        /data/coolify/ssl/cert.pem -> /etc/ssl/certs/coolify-ca.crt (read-only)
#   2) DATABASE_URL="postgresql://user:pass@db:5432/gradix?schema=public&sslmode=verify-ca&sslrootcert=/etc/ssl/certs/coolify-ca.crt"
# Napomena: bez mountanog CA fajla `verify-ca` NEĆE raditi — koristi
# `sslmode=require` ili `sslmode=disable` dok se CA ne mounta.

# === Backend (NestJS) ===
# Port na kojem API sluša UNUTAR kontejnera (host port se ne objavljuje).
PORT=3000
NODE_ENV=production
RUN_MIGRATIONS=true

# JWT tajne — MINIMUM 32 ZNAKA (openssl rand -base64 32)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-characters-replace-this"

# === MinIO (servis iz docker-compose.yml) ===
# `minio/minio` (Docker Hub) i `quay.io/minio/minio` više nisu javno
# dostupni. Alternativa: MINIO_IMAGE=quay.io/minio/aistor/minio:latest
MINIO_IMAGE=ghcr.io/coollabsio/minio:latest
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gradix

# === CORS ===
# Javni URL frontenda (Coolify domena). Više domena odvoji zarezom.
# D-041: dva domena — frontend poziva API na api.* domenu, pa CORS mora dozvoliti frontend origin.
CORS_ORIGIN="https://gradix.ba101.top"
# Nivo logovanja (INF-04): error | warn | info | debug. Prazno = info u produkciji,
# debug u razvoju, samo error u testovima. Log je JSON (jedan red po zapisu) i nikad
# ne sadrži tijelo zahtjeva, query string, headere, email/telefon ni tajne.
LOG_LEVEL=info

# API dokumentacija (Swagger) — u produkciji ISKLJUČENA osim ako je eksplicitno true.
ENABLE_API_DOCS=false

# === Frontend (nginx) ===
BACKEND_URL=http://backend:3000
# D-042: broj proxy hopova ispred API-ja (Coolify/Traefik = 1). 0 = nema proxy-ja (lokalno).
TRUST_PROXY=1
# D-041: origin API-ja koji ulazi u nginx CSP (connect-src za fetch, img-src za fajlove).
CSP_API_ORIGIN=https://api.gradix.ba101.top
# Prazno = relativni /api i /socket.io pozivi kroz nginx (preporučeno).
# D-041: build-time — pun URL API-ja na drugom domenu (mora odgovarati CSP_API_ORIGIN).
VITE_API_URL=https://api.gradix.ba101.top

# === Seed (obavezno ako pokrećeš seed; min 10 znakova) ===
# Produkcija: u Coolify terminalu nad backend kontejnerom → node dist/prisma/seed.js
SEED_PASSWORD="GradixSeed1"
# Produkcija: `false` — seed upisuje SAMO platform administratora (P9).
# `true` je za demo/razvoj i puni demo firmu sa podacima.
SEED_DEMO="false"

# === Host putanje (bind mount-ovi u docker-compose.yml) ===
# CA certifikati: Coolify ih drži na hostu, a DATABASE_URL ih traži U KONTEJNERU
# (`sslrootcert=/etc/ssl/certs/coolify-ca.crt`). Ako je CA na drugoj host
# putanji, mijenjaj SAMO ove dvije varijable — target u kontejneru ostaje isti.
# `create_host_path: false` → ako putanja ne postoji, deploy padne sa jasnom
# greškom (umjesto ENOENT-a u runtime-u).
POSTGRES_CA_FILE=/data/coolify/ssl/coolify-ca.crt
REDIS_CA_FILE=/data/coolify/ssl/redis-core/redis-ca.crt
# MinIO podaci na hostu (deljeni fajl sistem). Lokalno npr. ./.data/minio
MINIO_DATA_DIR=/mnt/shared-app-files/gradix/minio
# true (default) = entrypoint provjeri da CA iz DATABASE_URL postoji i padne odmah
SSL_PREFLIGHT=true

# === Redis (INF-07; opciono — prazan REDIS_HOST = throttle ostaje u memoriji) ===
# Host je `redis-core` na eksternoj mreži `redis_net`. Ako je host zadat, lozinka je obavezna.
REDIS_HOST=
REDIS_PORT=6380
REDIS_USER=gradix
# Lozinku generiše i unosi vlasnik infrastrukture (Coolify → Environment Variables).
REDIS_PASSWORD=
# Prefiks svih ključeva; ACL korisnik dobija pravo samo na `~<prefix>*` (scripts/ops/redis-acl.sh).
REDIS_PREFIX=gradix:
# Putanja CA za Redis UNUTAR kontejnera (izvor je REDIS_CA_FILE iznad).
REDIS_TLS_CA_FILE=/etc/ssl/redis/redis-ca.crt
