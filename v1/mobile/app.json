{
  "expo": {
    "name": "Gradix",
    "slug": "gradix",
    "version": "0.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gradix",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Gradix koristi lokaciju za geofence info i GPS ping.",
        "NSCameraUsageDescription": "Gradix koristi kameru za foto dnevnika i HSE.",
        "NSPhotoLibraryUsageDescription": "Gradix koristi galeriju za foto dnevnika i HSE."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        { "locationWhenInUsePermission": "Gradix koristi lokaciju za geofence info." }
      ],
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
