# Gradix — docker-compose env predložak
# Kopiraj u `.env` (git-ignored) i popuni vrijednosti:
#   cp .env.example .env
#
# Coolify: iste varijable unosiš u UI (Environment Variables) ili koristi
# `.env.coolify` kao predložak. Detalji: docs/INFRASTRUCTURE.md

# === PostgreSQL (EKSTERNI servis — nije u docker-compose.yml) ===
# Obavezno. Za Coolify Postgres sa TLS-om vidi docs/INFRASTRUCTURE.md §4 (preflight).
DATABASE_URL="postgresql://gradix_user:gradix_password@postgres:5432/gradix?schema=public"

# === JWT tajna (OBAVEZNO, minimum 32 znaka) ===
# Refresh tokeni NISU JWT: nasumični su i čuvaju se kao SHA-256 hash u bazi
# (D-029), pa im treba samo access tajna.
# Generisanje: openssl rand -base64 32
JWT_ACCESS_SECRET="change-me-access-secret-min-32-characters-replace-this"

# === Backend ===
NODE_ENV=production
# Port na kojem API sluša UNUTAR kontejnera (host port se ne objavljuje).
PORT=3000
# Kontejner sluša na 3000; host port se NE objavljuje (Coolify blue/green —
# vidi docs/INFRASTRUCTURE.md §8 (lokalno pokretanje) ako ti treba direktan pristup).
# Prisma migracije pri startu kontejnera (false = preskoči)
RUN_MIGRATIONS=true
# CORS — javni URL frontenda (prazno = dozvoljeni svi origin-i; postavi u produkciji!)
CORS_ORIGIN=""
# Nivo logovanja (INF-04): error | warn | info | debug. Prazno = info u produkciji,
# debug u razvoju, samo error u testovima. Log je JSON (jedan red po zapisu) i nikad
# ne sadrži tijelo zahtjeva, query string, headere, email/telefon ni tajne.
LOG_LEVEL=info

# === MinIO (interni servis iz compose fajla) ===
# Registry referenca image-a (default: Coolify-jev mirror klasičnog MinIO).
# `minio/minio` i `quay.io/minio/minio` više nisu javno dostupni.
# Alternativa: MINIO_IMAGE=quay.io/minio/aistor/minio:latest
MINIO_IMAGE=ghcr.io/coollabsio/minio:latest
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gradix
# MinIO se ne objavljuje na hostu (kontejner: 9000 API, 9001 konzola).
# Za direktan pristup dodijeli domenu MinIO servisu u Coolifyju.

# API dokumentacija (Swagger) — u produkciji ISKLJUČENA osim ako je eksplicitno true.
# Uključivanje izlaže cijelu površinu API-ja; koristi samo kratkotrajno.
ENABLE_API_DOCS=false

# === Frontend ===
# nginx sluša na 80 (bez host port-a — Coolify proxy routa domenu na kontejner)
# URL backenda za nginx proxy (/api, /socket.io)
BACKEND_URL=http://backend:3000
# Opciono: apsolutni URL API-ja (prazno = relativni pozivi kroz nginx proxy).
# Ovo je BUILD-TIME varijabla — mijenja vrijednost samo uz novi build frontenda.
VITE_API_URL=

# === Seed (obavezno ako pokrećeš seed; min 10 znakova) ===
# Razvoj: `npm run db:seed` · Kontejner/produkcija: `node dist/prisma/seed.js`
SEED_PASSWORD="GradixSeed1"
# `true` = seed puni demo firmu (Demo Gradnja, korisnici, projekti, vozila).
# Produkcija: `false` — seed tada upisuje samo platform administratora (P9).
SEED_DEMO="true"

# === Host putanje (bind mount-ovi u docker-compose.yml) ===
# CA certifikati: Coolify ih drži na hostu, a DATABASE_URL ih traži U KONTEJNERU
# (`sslrootcert=/etc/ssl/certs/coolify-ca.crt`). Ako je CA na drugoj host
# putanji, mijenjaj SAMO ove dvije varijable — target u kontejneru ostaje isti.
# `create_host_path: false` → ako putanja ne postoji, deploy padne sa jasnom
# greškom (umjesto ENOENT-a u runtime-u).
POSTGRES_CA_FILE=/data/coolify/ssl/coolify-ca.crt
REDIS_CA_FILE=/data/coolify/ssl/redis-core/redis-ca.crt
# MinIO podaci na hostu (deljeni fajl sistem). Lokalno npr. ./.data/minio
MINIO_DATA_DIR=/mnt/shared-app-files/gradix/minio
# true (default) = entrypoint provjeri da CA iz DATABASE_URL postoji i padne odmah
SSL_PREFLIGHT=true

# === Redis (INF-07; opciono — bez REDIS_HOST throttle radi u memoriji) ===
# Host je `redis-core` u eksternoj mreži `redis_net` (ne pokreće se ovim compose fajlom).
# Prazno = Redis se ne koristi. Ako je host zadat, REDIS_PASSWORD je OBAVEZAN.
REDIS_HOST=
REDIS_PORT=6380
# ACL korisnik (lozinku generiše vlasnik infrastrukture; ACL linija: scripts/ops/redis-acl.sh).
REDIS_USER=gradix
REDIS_PASSWORD=
# Prefiks SVIH ključeva koje backend dira; mora odgovarati ACL obrascu `~<prefix>*`.
REDIS_PREFIX=gradix:
# Putanja CA za Redis UNUTAR kontejnera (izvor je REDIS_CA_FILE iznad).
REDIS_TLS_CA_FILE=/etc/ssl/redis/redis-ca.crt
