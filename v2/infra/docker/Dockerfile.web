# Web (Next.js standalone) + API. Jedan kontejner, jedan domen, /api na istoj adresi (G0/P4).
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# 1) Zavisnosti: samo manifesti, da se kešira sloj.
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc turbo.json ./
COPY packages/config/package.json packages/config/
COPY packages/domain/package.json packages/domain/
COPY packages/db/package.json packages/db/
COPY apps/web/package.json apps/web/
COPY apps/mobile/package.json apps/mobile/
RUN pnpm install --frozen-lockfile --filter @gradix/web...

# 2) Build
FROM deps AS builder
COPY packages packages
COPY apps/web apps/web
# `next build` traži DATABASE_URL samo ako se stranica izvršava u build vremenu;
# sve poslovne stranice su `force-dynamic`, pa placeholder ne utiče na izlaz.
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
ENV AUTH_SECRET=build-time-placeholder-secret-min-32-chars
RUN pnpm --filter @gradix/web build

# 3) Runtime: samo ono što treba, bez pnpm-a i dev zavisnosti.
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
# psql je potreban samo ako entrypoint primjenjuje migracije (RUN_MIGRATIONS=true).
RUN apk add --no-cache postgresql-client \
 && addgroup -g 1001 -S nodejs \
 && adduser -S -u 1001 -G nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
# Migracije i bootstrap rola idu u sliku: entrypoint ih primjenjuje prije starta.
COPY --from=builder --chown=nextjs:nodejs /app/packages/db/prisma/migrations ./db/migrations
COPY --from=builder --chown=nextjs:nodejs /app/packages/db/bootstrap ./db/bootstrap
COPY --chown=nextjs:nodejs infra/docker/entrypoint-web.sh ./entrypoint.sh
COPY --chown=nextjs:nodejs infra/scripts/db-apply.sh ./db/apply.sh

USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["./entrypoint.sh"]
