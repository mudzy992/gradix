# Worker (poslovi u pozadini, pg-boss) — ODVOJEN kontejner od weba.
#
# Zašto odvojeno: web je Next.js standalone slika bez dev zavisnosti, a worker drži dugotrajne
# konekcije i mora se moći restartovati bez prekida HTTP saobraćaja. Isto kao kod weba, build
# kontekst je KORIJEN v2 monorepa (Coolify: Base Directory /v2 → context ".").
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# 1) Zavisnosti: samo manifesti → sloj se kešira dok se kod ne mijenja.
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc turbo.json ./
COPY packages/config/package.json packages/config/
COPY packages/design/package.json packages/design/
COPY packages/domain/package.json packages/domain/
COPY packages/contracts/package.json packages/contracts/
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY apps/worker/package.json apps/worker/
RUN pnpm install --frozen-lockfile --filter @gradix/worker... --filter @gradix/web...

# 2) Build: esbuild bundle u `dist/main.js` (+ `.map`).
#    Zašto NE goli `tsc`: emituje relativne uvoze bez `.js` (`./config`), što Node ESM ne
#    razrješava — worker je u produkciji padao sa „Cannot find module '/app/apps/worker/dist/config'".
#    Bundle ugrađuje naše module (@gradix/domain, @gradix/db i relativne), a npm paketi ostaju
#    vanjski (pg, pg-boss, S3) i dolaze iz node_modules u runner sloju.
FROM deps AS builder
COPY packages/config packages/config
COPY packages/domain packages/domain
COPY packages/contracts packages/contracts
COPY apps/web/src/server apps/web/src/server
COPY packages/db packages/db
COPY apps/worker apps/worker
# `@gradix/domain` i `@gradix/db` NE grade se odvojeno: njihov `exports` pokazuje na `src/*.ts`,
# a esbuild ih čita i ugrađuje u bundle (`build.mjs`, plugin za workspace pakete). Ranija
# verzija je zvala `pnpm --filter @gradix/domain build`, a tog skripta nema.
RUN pnpm --filter @gradix/worker build

# 3) Runtime: produkcijske zavisnosti + dist. Nema pnpm-a, nema dev alata.
FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/domain/node_modules ./packages/domain/node_modules
COPY --from=builder /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=builder /app/apps/worker/node_modules ./apps/worker/node_modules
# Izvor workspace paketa NE ide u sliku: bundle ga je već ugradio. Ovo je i sigurnosno bolje —
# u runtime sloju nema `.ts` izvora koji bi Node pokušao učitati i pasti na ekstenzijama.
COPY --from=builder /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder /app/apps/worker/package.json ./apps/worker/package.json
# Migracije ostaju u slici: worker ih NE primjenjuje (to radi web pri startu), ali operator
# mora imati `psql`-spremne fajlove u kontejneru za dijagnostiku.
COPY --from=builder /app/packages/db/migrations ./packages/db/migrations

# Healthcheck stiže iz pg-boss-a: `ping.health` mora proći unutar 30 min, inače je red pokvaren.
# Ovdje provjeravamo samo da proces živi; stanje reda čita web (`/api/health/queue`).
HEALTHCHECK --interval=60s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "process.exit(0)"

CMD ["node", "apps/worker/dist/main.js"]
