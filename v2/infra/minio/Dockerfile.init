# The upstream mc image is scratch-based with ENTRYPOINT=mc and has no shell.
# Copy its static client into Alpine, then bake the shell bootstrap into the image itself.
FROM minio/mc:RELEASE.2025-10-15T17-29-55Z AS mc

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=mc /usr/bin/mc /usr/local/bin/mc
COPY infra/minio/init-staging.sh /init.sh
COPY infra/minio/staging-policy.json /policy.json
ENTRYPOINT ["/bin/sh", "/init.sh"]
