# Gradix v2 — šema konfiguracije. Ne unositi stvarne tajne u repo.
# Coolify staging defaults su zaključani u infra/coolify/docker-compose.yml;
# ovaj fajl sadrži samo vrijednosti koje operator treba ili može unijeti.
# Detalji: docs/COOLIFY.md. Mobilni lokalni env: apps/mobile/.env.example.

# --- Aplikacija -------------------------------------------------------------
LOG_LEVEL=info             # [C/L] info (Coolify default)
TRUST_PROXY=1              # [C] Coolify = 1 proxy hop
TZ=Europe/Sarajevo         # [C] vremenska zona

# --- Baza (obavezno) --------------------------------------------------------
# Aplikacijska rola: NOSUPERUSER, NOBYPASSRLS; format postgresql://...
DATABASE_URL=
# Odvojeni vlasnik šeme/migrator; obavezan kad je RUN_MIGRATIONS=true.
DATABASE_ADMIN_URL=
PGSSLMODE=verify-full      # [C] koristi montirani Coolify CA
POSTGRES_CA_FILE=/data/coolify/ssl/coolify-ca.crt  # [C] putanja na hostu
POSTGRES_CA_MOUNT_CREATE_PATH=false                # [C] padni jasno ako CA nedostaje

# --- Autentikacija (obavezno) ----------------------------------------------
# Generiši: openssl rand -base64 48. Rotacija odjavljuje sve korisnike.
AUTH_SECRET=
# Tačan javni HTTPS origin za WebAuthn, bez putanje; RP ID je hostname.
APP_URL=https://gradix.ba101.top
# Ako je postavljen, NEXT_PUBLIC_APP_URL mora imati isti origin kao APP_URL.
NEXT_PUBLIC_APP_URL=

# --- Migracije i demo podaci -----------------------------------------------
RUN_MIGRATIONS=true        # [C] idempotentne migracije pri startu
PILOT_TEST_PASSWORD=       # [L] privremena lozinka samo za namjensku pilot bazu; ne čuvati u repo-u
SEED_PASSWORD=             # [C] jaka privremena demo lozinka; ukloniti nakon seeda

# --- MinIO / S3 -------------------------------------------------------------
# Compose fiksira MINIO_ENDPOINT=http://minio:9000, MINIO_BUCKET=gradix-stg
# i MINIO_REGION=us-east-1. Ne dodavati te fiksne vrijednosti u Coolify env.
MINIO_PUBLIC_ENDPOINT=     # [C] javni HTTPS origin koji vidi browser; obavezan za priloge
MINIO_ACCESS_KEY=          # [C] app-only nalog; >=20 znakova, različit od MINIO_ROOT_USER
MINIO_SECRET_KEY=          # [C] app-only secret; >=32 znaka, Coolify secret, nikad MinIO server
MINIO_CORS_ALLOWED_ORIGIN=https://gradix.ba101.top  # [C] tačan web origin; server-wide MinIO CORS
# Obavezni MinIO server root secrets; bez defaultnih minioadmin kredencijala.
MINIO_ROOT_USER=           # [C] Coolify secret
MINIO_ROOT_PASSWORD=       # [C] Coolify secret
SERVICE_FQDN_MINIO=        # [C] Coolify-managed; postojeća S3 API ruta ostaje na portu 9000
SERVICE_FQDN_MINIO_CONSOLE_PROXY=  # [C] Coolify-managed Console hostname (proxy listens on 8080)
MINIO_BROWSER_REDIRECT_URL=https://minio-console.gradix.ba101.top  # [C] javni HTTPS URL Consolea
# Coolify Domains: dodaj minio-console.gradix.ba101.top na servis minio-console-proxy (port 8080);
# uključi HTTP→HTTPS. Console ima samo MinIO login, bez dodatne IP/VPN/SSO zaštite.
# Podaci se čuvaju na /mnt/shared-app-files/gradix-v2/minio (Compose bind na /data).

# --- Redis dijagnostika (aplikacija ne zavisi od Redisa) --------------------
# Compose fiksira redis-core:6380, ACL user gradix_v2, prefix gradix:stg: i
# REDIS_TLS_CA_FILE=/run/secrets/redis-ca.crt. Samo postojeća ACL lozinka je tajna:
REDIS_PASSWORD=            # [C] postojeći gradix_v2 ACL secret; ne commitovati

# --- Ograničenje prijava ----------------------------------------------------
AUTH_LOGIN_LIMIT=5         # [C] pokušaja po IP+email, dozvoljeno 1–50 (default 5)
AUTH_LOGIN_WINDOW_MS=60000 # [C] prozor u MILISEKUNDAMA, dozvoljeno 10000–3600000 (default 60000); aplikacija odbija start izvan raspona

# --- Sigurnosne kopije (zakazani zadatak, NE web kontejner) — docs/COOLIFY.md §12
# DATABASE_BACKUP_URL=       # gradix_backup: BYPASSRLS + SELECT; nikad web/gradix_app
# BACKUP_ROLE_PASSWORD=      # lozinka role; provision: backup-provision-role.sh
# BACKUP_ENCRYPTION_KEY=     # Coolify/host secret; nikad u MinIO-u; izgubljen ključ = izgubljene kopije
# BACKUP_DEST=s3             # local (CI) | s3 (staging → app MinIO, zaseban bucket)
# BACKUP_DIR=/var/backups/gradix-v2
# BACKUP_RETENTION=30
# BACKUP_MAX_AGE_HOURS=26
# BACKUP_S3_ENDPOINT=        # API istog app MinIO-a (npr. javni HTTPS)
# BACKUP_S3_BUCKET=          # zaseban backup bucket (ne MINIO_BUCKET)
# BACKUP_S3_PREFIX=backups
# BACKUP_S3_ACCESS_KEY=      # zaseban nalog (ne MINIO_ACCESS_KEY)
# BACKUP_S3_SECRET_KEY=      # zaseban secret (ne MINIO_SECRET_KEY)
# RESTORE_ADMIN_URL=         # admin na praznoj ciljnoj bazi (npr. .../gradix_restore)
# RESTORE_DATABASE_URL=      # app URL na istoj restore bazi (opciono)
# Lokalno: ./v2/infra/scripts/backup-env-prepare.sh zatim provision-role / provision-minio

# --- Worker (pg-boss) -------------------------------------------------------
# Worker traži DATABASE_ADMIN_URL (vlasnik šeme) jer sam pravi i održava `pgboss` šemu.
REMINDER_INTERVAL_MINUTES=15   # canarinac `ping.health`; 1 u lokalnom testu reda
JOB_EXPIRE_MINUTES=15          # posao koji visi duže se vraća u red
WORKER_CONCURRENCY=4
# Odvoji red od poslovnih podataka samo ako je red na drugoj bazi; inače prazno.
BOSS_DATABASE_URL=
# Faza 0 nema provajdere: bez ovih vrijednosti isporuka je BLOCKED_NO_PROVIDER, ne FAILED.
SMTP_HOST=
SMTP_FROM=
EXPO_ACCESS_TOKEN=
# Opcioni mjesečni izvještaj (firma ga mora posebno uključiti). SMTP autentikacija traži TLS.
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Ishod SMTP pokušaja može biti nepoznat; provjeriti provider prije eventualnog ručnog ponavljanja.
