# Gradix v2 — šema konfiguracije. SAMO IMENA I OPISI, nikad vrijednosti.
# Stvarne vrijednosti žive u root `.env` (van gita) i u Coolifyju.
# Šema preuzeta iz v1/.env.example; varijable koje v2 ne koristi u Fazi 1 su označene.
# Izvor: v1/.env.example

# --- Aplikacija -------------------------------------------------------------
NODE_ENV=            # development | test | production
PORT=                # port Node procesa (web + /api)

# --- Baza -------------------------------------------------------------------
# Jedan connection string. U produkciji TLS sa CA (vidi PGSSLROOTCERT/sslrootcert).
DATABASE_URL=
# Putanja CA certifikata za PostgreSQL unutar kontejnera (v1: /etc/ssl/certs/coolify-ca.crt).
POSTGRES_CA_FILE=
# verify-ca | require — v1 produkcija koristi verify-ca.
PGSSLMODE=
# Putanja CA koju vidi pg klijent.
PGSSLROOTCERT=

# --- Autentikacija ----------------------------------------------------------
# Tajna za sesijske tokene. Min. 32 znaka. Rotira vlasnik.
AUTH_SECRET=

# --- Fajlovi (MinIO / S3) ---------------------------------------------------
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
# Putanja podataka na hostu (bind mount) — postavlja infrastruktura, ne aplikacija.
MINIO_DATA_DIR=

# --- Redis (opciono; samo ako donosi vrijednost uz 2+ replike) --------------
REDIS_HOST=          # prazno = Redis se ne koristi
REDIS_PORT=          # 6380 = TLS port na redis-core
REDIS_USER=
REDIS_PASSWORD=
REDIS_PREFIX=        # v1: gradix: ; v2 predlog: gx2:
REDIS_TLS_CA_FILE=
REDIS_CA_FILE=       # host putanja koja se montira kao REDIS_TLS_CA_FILE

# --- Deploy i okolina -------------------------------------------------------
RUN_MIGRATIONS=      # true = entrypoint pokreće migracije
SSL_PREFLIGHT=       # true = provjeri CA prije migracija
TRUST_PROXY=         # broj proxy hopova (Coolify = 1)
CORS_ORIGIN=         # prazno = same-origin (preporučeno uz jedan domen)
LOG_LEVEL=           # error | warn | info | debug
ENABLE_API_DOCS=     # true samo van produkcije
BACKEND_URL=         # interni URL API-ja za proxy

# --- Throttling -------------------------------------------------------------
THROTTLE_LIMIT=
THROTTLE_TTL_MS=
AUTH_LOGIN_LIMIT=
AUTH_REFRESH_LIMIT=

# --- Seed / demo ------------------------------------------------------------
SEED_PASSWORD=       # samo za seed, nikad produkcijska lozinka
SEED_DEMO=           # true = demo podaci (samo izolovana baza)

# --- NE KORISTI SE U V2 (naslijeđeno iz v1, ostaje dokumentovano) -----------
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET — v1 ih je zamijenio sesijskim modelom (D-029)
# REFRESH_REPLAY_SECRET — v2 ne uvodi replay zaštitu (B6.16)
# VITE_API_URL / CSP_API_ORIGIN — v1 dvodomenski raspored; v2 koristi jedan domen (G0/P4)
