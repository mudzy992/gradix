# Gradix v2 — šema konfiguracije. Ne unositi stvarne tajne u repo.
# Coolify staging defaults su zaključani u infra/coolify/docker-compose.yml;
# ovaj fajl sadrži samo vrijednosti koje operator treba ili može unijeti.
# Detalji: docs/COOLIFY.md. Mobilni lokalni env: apps/mobile/.env.example.

# --- Aplikacija -------------------------------------------------------------
LOG_LEVEL=info             # [C/L] info (Coolify default)
TRUST_PROXY=1              # [C] Coolify = 1 proxy hop
TZ=Europe/Sarajevo         # [C] vremenska zona

# --- Baza (obavezno) --------------------------------------------------------
# Aplikacijska rola: NOSUPERUSER, NOBYPASSRLS; format postgresql://...
DATABASE_URL=
# Odvojeni vlasnik šeme/migrator; obavezan kad je RUN_MIGRATIONS=true.
DATABASE_ADMIN_URL=
PGSSLMODE=verify-full      # [C] koristi montirani Coolify CA
POSTGRES_CA_FILE=/data/coolify/ssl/coolify-ca.crt  # [C] putanja na hostu
POSTGRES_CA_MOUNT_CREATE_PATH=false                # [C] padni jasno ako CA nedostaje

# --- Autentikacija (obavezno) ----------------------------------------------
# Generiši: openssl rand -base64 48. Rotacija odjavljuje sve korisnike.
AUTH_SECRET=

# --- Migracije i demo podaci -----------------------------------------------
RUN_MIGRATIONS=true        # [C] idempotentne migracije pri startu
SEED_PASSWORD=             # [C] jaka privremena demo lozinka; ukloniti nakon seeda

# --- MinIO / S3 -------------------------------------------------------------
# Compose fiksira MINIO_ENDPOINT=http://minio:9000, MINIO_BUCKET=gradix-stg
# i MINIO_REGION=us-east-1. Ne dodavati te fiksne vrijednosti u Coolify env.
MINIO_PUBLIC_ENDPOINT=     # [C] javni HTTPS origin koji vidi browser; obavezan za priloge
MINIO_ACCESS_KEY=          # [C] app-only nalog; >=3 chars, različit od MINIO_ROOT_USER
MINIO_SECRET_KEY=          # [C] app-only secret; >=8 chars, Coolify secret, nikad MinIO server
MINIO_CORS_ALLOWED_ORIGIN=https://gradix.ba101.top  # [C] tačan web origin; server-wide MinIO CORS
# Obavezni MinIO server root secrets; bez defaultnih minioadmin kredencijala.
MINIO_ROOT_USER=           # [C] Coolify secret
MINIO_ROOT_PASSWORD=       # [C] Coolify secret
SERVICE_FQDN_MINIO=        # [C] Coolify service hostname, ako ga Coolify generiše
# Podaci se čuvaju na /mnt/shared-app-files/gradix-v2/minio (Compose bind na /data).

# --- Redis dijagnostika (aplikacija ne zavisi od Redisa) --------------------
# Compose fiksira redis-core:6380, ACL user gradix_v2, prefix gradix:stg: i
# REDIS_TLS_CA_FILE=/run/secrets/redis-ca.crt. Samo postojeća ACL lozinka je tajna:
REDIS_PASSWORD=            # [C] postojeći gradix_v2 ACL secret; ne commitovati

# --- Ograničenje prijava ----------------------------------------------------
AUTH_LOGIN_LIMIT=5         # [C] pokušaja po IP+email (default 5)
AUTH_LOGIN_WINDOW_MS=60000 # [C] prozor u milisekundama (default 60000)
