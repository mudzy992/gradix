# Gradix v2 — šema konfiguracije. SAMO IMENA I OPISI, nikad vrijednosti.
# Ovo je isti fajl za dva mjesta: (1) Coolify resource `gradix-web`, (2) lokalni `.env`.
# Detalji za Coolify: docs/COOLIFY.md. Tajne po okruženjima: docs/GH-SECRETS.md
#
# Oznake:  [C] = samo Coolify   [L] = samo lokalno   [C/L] = oboje

# --- Aplikacija -------------------------------------------------------------
NODE_ENV=            # [C] production (u Coolifyju ga postavlja compose — ne moraš ručno)
PORT=                # [C] 3000 (compose ga postavlja)
LOG_LEVEL=           # [C/L] error | warn | info | debug  (Coolify: info)
TRUST_PROXY=         # [C] broj proxy hopova; Coolify = 1
TZ=                  # [C] Europe/Sarajevo

# --- Baza (obavezno) --------------------------------------------------------
# Konekcija kojom radi APLIKACIJA. Rola mora biti NOSUPERUSER i NOBYPASSRLS.
# format: postgresql://gradix_app:LOZINKA@HOST:5432/gradix?schema=public
DATABASE_URL=
# Konekcija za migracije (VLASNIK ŠEME). U Coolifyju je OBAVEZNO kad šemu posjeduje
# rola `gradix` a aplikacija radi kao `gradix_app` (model C) — tada `gradix_app`
# nema CREATE na public šemi i migracija bi pala.
# Ako je `gradix_app` ujedno vlasnik baze (model B), može ostati prazno.
DATABASE_ADMIN_URL=
PGSSLMODE=           # [C/L] verify-full uz Coolify CA | require | disable (samo lokalno)
                     # PAZI: `&` u URL-u, nikad `&amp;` (copy/paste iz HTML-a)
PGSSLROOTCERT=       # [L] putanja do CA certifikata ako baza traži verifikaciju
POSTGRES_CA_FILE=              # [C] CA na HOSTU -> /etc/ssl/certs/coolify-ca.crt
POSTGRES_CA_MOUNT_CREATE_PATH=  # [C] false (default) = padni jasno ako CA ne postoji

# --- Autentikacija (obavezno) ----------------------------------------------
# Tajna za potpis sesijskih tokena. MIN 32 ZNAKA (kontejner odbija start ako je kraća).
# Generisanje: openssl rand -base64 48. Rotacija odjavljuje sve korisnike.
AUTH_SECRET=

# --- Migracije i prvi deploy -------------------------------------------------
RUN_MIGRATIONS=      # [C] true = entrypoint primjenjuje migracije pri startu (idempotentno)
SSL_PREFLIGHT=       # [C] true = provjeri CA prije migracija (samo kad je TLS obavezan)

# --- Demo podaci (opciono, samo za testnu domenu) ---------------------------
SEED_PASSWORD=       # lozinka za demo naloge; NIKAD produkcijska. Ukloni poslije seeda.
SEED_DEMO=           # true = demo firme/korisnici (samo izolovana baza)

# --- Fajlovi (MinIO/S3) — NE u Fazi 1 ---------------------------------------
# Prvi put potrebno od R5 (prilozi). Bucket: gradix-v2, prefiks gx2/ (ADR 0006).
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=        # gradix-v2
MINIO_DATA_DIR=      # [L] host bind mount za /data

# --- Redis — NE u Fazi 1 ----------------------------------------------------
# Uključuje se samo uz 2+ replike ili pozadinske poslove (tada: ADR + ACL korisnik).
REDIS_HOST=          # prazno = Redis se ne koristi
REDIS_PORT=          # 6380 = TLS port
REDIS_USER=
REDIS_PASSWORD=
REDIS_PREFIX=        # gx2:
REDIS_TLS_CA_FILE=   # koristi se tek kad Redis uđe u upotrebu
REDIS_CA_FILE=       # CA na hostu za Redis; NIJE montiran u Fazi 1

# --- Throttling -------------------------------------------------------------
# R0: brojač je u memoriji procesa (bez Redisa) — dovoljno za jednu repliku.
AUTH_LOGIN_LIMIT=      # [C] pokušaja prijave po IP+email u prozoru (zadano 5)
AUTH_LOGIN_WINDOW_MS=  # [C] dužina prozora u ms (zadano 60000)
# Rezervisano, kod ih JOŠ NE ČITA — ne postavljati:
# THROTTLE_LIMIT, THROTTLE_TTL_MS, AUTH_REFRESH_LIMIT, CORS_ORIGIN, ENABLE_API_DOCS

# --- Mobilni (lokalno, van Coolifyja) ---------------------------------------
EXPO_PUBLIC_API_URL= # [L] pun URL API-ja koji vidi uređaj: https://gradix.ba101.top

# --- NE KORISTI SE U V2 (naslijeđeno iz v1, ostaje dokumentovano) -----------
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET — zamijenjeni sa AUTH_SECRET (ADR 0005)
# REFRESH_REPLAY_SECRET — v2 nema replay zaštitu (B6.16, ADR 0005)
# VITE_API_URL / CSP_API_ORIGIN — v1 dvodomenski raspored; v2 koristi jedan domen (G0/P4)
# BACKEND_URL — nema odvojenog proxy sloja; Next servira i /api
