# Gradix v2 — šema konfiguracije. SAMO IMENA I OPISI, nikad vrijednosti.
# Stvarne vrijednosti žive u root `.env` (van gita) i u Coolifyju. Detalji: docs/GH-SECRETS.md
# Šema preuzeta iz v1/.env.example; varijable koje v2 ne koristi su na dnu, dokumentovane.

# --- Aplikacija -------------------------------------------------------------
NODE_ENV=            # development | test | production
PORT=                # port Node procesa (web + /api)

# --- Baza -------------------------------------------------------------------
# Jedan connection string za APLIKACIJU. Rola mora biti NOSUPERUSER / NOBYPASSRLS
# i ne smije biti vlasnik tabela — inače RLS ne štiti (ADR 0003).
DATABASE_URL=
# Odvojena konekcija za migracije (vlasnik šeme). Koristi se samo kad je RUN_MIGRATIONS=true.
DATABASE_ADMIN_URL=
POSTGRES_CA_FILE=    # putanja CA unutar kontejnera (v1: /etc/ssl/certs/coolify-ca.crt)
PGSSLMODE=           # verify-ca | require
PGSSLROOTCERT=       # putanja CA koju vidi pg klijent

# --- Autentikacija ----------------------------------------------------------
# Tajna za potpis sesijskih tokena. Min. 32 znaka. Rotacija odjavljuje sve korisnike.
AUTH_SECRET=

# --- Fajlovi (MinIO / S3) ---------------------------------------------------
# U R0 se ne koriste (nema priloga); potrebno od R5. Bucket: gradix-v2 (ADR 0006).
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=        # gradix-v2
MINIO_DATA_DIR=      # host bind mount za /data — postavlja infrastruktura

# --- Redis (opciono; samo uz 2+ replike ili pozadinske poslove) --------------
REDIS_HOST=          # prazno = Redis se ne koristi
REDIS_PORT=          # 6380 = TLS port na redis-core
REDIS_USER=
REDIS_PASSWORD=
REDIS_PREFIX=        # v2: gx2:
REDIS_TLS_CA_FILE=
REDIS_CA_FILE=

# --- Deploy i okolina -------------------------------------------------------
RUN_MIGRATIONS=      # true = entrypoint primjenjuje migracije (traži DATABASE_ADMIN_URL)
SSL_PREFLIGHT=       # true = provjeri CA prije migracija
TRUST_PROXY=         # broj proxy hopova (Coolify = 1)
CORS_ORIGIN=         # prazno = same-origin (preporučeno uz jedan domen)
LOG_LEVEL=           # error | warn | info | debug
ENABLE_API_DOCS=     # true samo van produkcije

# --- Throttling -------------------------------------------------------------
THROTTLE_LIMIT=
THROTTLE_TTL_MS=
AUTH_LOGIN_LIMIT=
AUTH_REFRESH_LIMIT=

# --- Seed / demo ------------------------------------------------------------
SEED_PASSWORD=       # samo za seed, nikad produkcijska lozinka
SEED_DEMO=           # true = demo podaci (samo izolovana baza)

# --- Mobilni ----------------------------------------------------------------
EXPO_PUBLIC_API_URL= # pun URL API-ja koji vidi uređaj (npr. https://staging.poddomena.ba101.top)

# --- NE KORISTI SE U V2 (naslijeđeno iz v1, ostaje dokumentovano) -----------
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET — zamijenjeni sa AUTH_SECRET (ADR 0005)
# REFRESH_REPLAY_SECRET — v2 nema replay zaštitu (B6.16, ADR 0005)
# VITE_API_URL / CSP_API_ORIGIN — v1 dvodomenski raspored; v2 koristi jedan domen (G0/P4)
# BACKEND_URL — nema odvojenog proxy sloja; Next servira i /api
