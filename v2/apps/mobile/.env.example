# Mobilni — primjer okruženja. Kopiraj u `.env` (isti direktorij) i mijenjaj.
#
# `.env` je u .gitignore. Ovo nije tajna: API URL je javna adresa.

# Baza za API klijent na telefonu. Telefon NE može na 127.0.0.1 računara,
# zato mora puna adresa servera. Testna domena:
EXPO_PUBLIC_API_URL=https://gradix.ba101.top

# Lokalni API sa računara (samo emulator/simulator ili Expo web):
# EXPO_PUBLIC_API_URL=http://localhost:3000

# PAZI: EXPO_PUBLIC_* se ubacuje u bundle pri bundlovanju — poslije promjene
# restartuj Metro sa: pnpm start -- --clear
