// Šema za Fazu 1 (hodajući kostur) — NIJE konačni model podataka.
// Konačni model je Faza 2 (A4). Ovdje su samo entiteti potrebni za R0 i za RLS spike.
//
// Namjerno prisutno od prve migracije (odluke G0, ADR 0001):
//   - Membership razdvaja korisnika od firme (v1 je imao User.companyId, zamka iz B6.12)
//   - Money: iznos je Decimal + valuta uz njega (nikad goli broj)
//   - stacionaža i partner su predviđeni u modelu (dolaze u R2/R3, ne u R0)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 NE dozvoljava `url` ovdje. Konekcija je u `prisma.config.ts`
  // (objašnjenje: ADR 0002). Šema opisuje samo modele.
}

enum Locale {
  bs
  en
}

enum Role {
  // Role unutar firme. Operator platforme NIJE rola u firmi (vidi PlatformUser).
  OWNER
  ADMIN
  PROJECT_MANAGER
  SITE_SUPERVISOR
  WORKER
  DRIVER
  MACHINE_OPERATOR
  MECHANIC
  ACCOUNTANT
}

model Company {
  id                        String   @id @default(cuid())
  name                      String
  slug                      String   @unique
  timezone                  String   @default("Europe/Sarajevo")
  currency                  String   @default("BAM")
  locale                    Locale   @default(bs)
  isActive                  Boolean  @default(true)
  // Privremeni default; zakonska potvrda retention roka ostaje otvorena u R4 planu.
  syncConflictRetentionDays Int      @default(90) @map("sync_conflict_retention_days") @db.SmallInt
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  memberships Membership[]
  machines    Machine[]
  categories  EquipmentCategory[]
  workers     Worker[]
  auditEvents AuditEvent[]

  @@map("companies")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  firstName          String
  lastName           String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  locale             Locale    @default(bs)
  // Tenantski ključ nije na korisniku nego na članstvu; polje ostaje radi RLS-a
  // na tabeli koja nije tenant-vlasništvo (korisnik može biti u više firmi kasnije).
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships Membership[]
  sessions    Session[]
  auditEvents AuditEvent[]

  @@map("users")
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  roles     Role[]
  scope     String   @default("SELF")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  companyId  String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
  @@map("sessions")
}

// Mašine i vozila — JEDNA tabela. Razlika je kategorija i vrsta brojila (sati ili kilometri);
// registracija i tehnički pregled su obaveze (R2b), ne kolone.
// `meterValue` je samo TRENUTNA vrijednost: historija očitanja je R5.
model Machine {
  id             String    @id @default(cuid())
  companyId      String
  code           String
  name           String
  categoryId     String
  make           String?
  model          String?
  serialNo       String?
  plate          String?
  year           Int?
  ownership      String    @default("OWN")
  meter          String    @default("HOURS")
  meterValue     Decimal?  @db.Decimal(12, 1)
  meterUpdatedAt DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Kompozitni FK: kategorija mora biti IZ ISTE FIRME (vidi migraciju r2a, §3).
  category EquipmentCategory @relation(fields: [companyId, categoryId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, categoryId])
  @@map("machines")
}

// Kategorije su PODACI po firmi, ne `enum`: firma dodaje svoju kategoriju bez migracije.
// `meter` je zadana vrsta brojila koju mašina nasljeđuje pri kreiranju.
model EquipmentCategory {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  meter     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  machines Machine[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, sortOrder])
  @@map("equipment_categories")
}

// Radnik ≠ korisnik. `userId` je OPCIONA veza koju pravi administrator; radnik bez naloga je
// uobičajen slučaj. Namjerno NEMA kolona za JMBG, adresu ni bankovni račun (odluka vlasnika).
model Worker {
  id           String    @id @default(cuid())
  companyId    String
  firstName    String
  lastName     String
  phone        String?
  email        String?
  jobTitle     String?
  engagement   String    @default("PERMANENT")
  hiredAt      DateTime  @db.Date
  endedAt      DateTime? @db.Date
  team         String?
  supervisorId String?
  userId       String?   @unique
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Nadređeni iz iste firme: kompozitni FK, ne samo `id`.
  supervisor Worker?  @relation("WorkerSupervisor", fields: [companyId, supervisorId], references: [companyId, id], onDelete: SetNull)
  reports    Worker[] @relation("WorkerSupervisor")

  @@unique([companyId, id])
  @@index([companyId, lastName, firstName])
  @@map("workers")
}

model AuditEvent {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String?
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("audit_events")
}

// Operator platforme nije korisnik firme: odvojen entitet, odvojen prikaz, odvojena sesija.
model PlatformUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())

  @@map("platform_users")
}
