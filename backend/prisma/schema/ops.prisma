enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectAssignmentRole {
  PM
  SS
  WORKER
  DRIVER
  OP
}

enum TimerApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuantityUnit {
  M3
  T
  M
  M2
  PCS
  H
}

enum AmendmentEntityType {
  TIMER
  TRIP
  FUEL
}

enum TaskDependencyType {
  FS
}

model Project {
  id              String        @id @default(cuid())
  companyId       String
  code            String?
  name            String
  status          ProjectStatus @default(PLANNING)
  locality        String?
  lat             Decimal?      @db.Decimal(10, 7)
  lng             Decimal?      @db.Decimal(10, 7)
  geofenceRadius  Int
  plannedBudget   Decimal?      @db.Decimal(12, 2)
  currentSpend    Decimal       @default(0) @db.Decimal(12, 2)
  progressPercent Int           @default(0)
  client          String?
  partnerId       String?
  isPublic        Boolean       @default(false)
  coverAssetId    String?
  archivedAt      DateTime?
  plannedStart    DateTime?
  plannedEnd      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         Company       @relation(fields: [companyId], references: [id])
  partner         Partner?      @relation(fields: [partnerId], references: [id])
  phases          ProjectPhase[]
  assignments     ProjectAssignment[]
  documents       ProjectDocument[]
  tasks           Task[]
  quantities      QuantityItem[]
  machineAssignments MachineAssignment[]
  trips           Trip[]
  fuelEntries     FuelEntry[]
  diaryEntries    DiaryEntry[]
  incidents       Incident[]
  convertedTenders Tender[]
  serviceRecords  ServiceRecord[]
  costEntries     CostEntry[]
  warehouses      Warehouse[]
  stockMovements  StockMovement[]
  coverAsset      PublicAsset?  @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)

  @@unique([companyId, code])
  @@index([companyId, status])
}

model ProjectPhase {
  id              String    @id @default(cuid())
  companyId       String
  projectId       String
  name            String
  sortOrder       Int
  plannedStart    DateTime?
  plannedEnd      DateTime?
  progressPercent Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id])
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks           Task[]
  quantities      QuantityItem[]

  @@index([projectId])
}

model ProjectAssignment {
  id        String                @id @default(cuid())
  companyId String
  projectId String
  userId    String
  role      ProjectAssignmentRole
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  company   Company               @relation(fields: [companyId], references: [id])
  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectDocument {
  id        String   @id @default(cuid())
  companyId String
  projectId String
  path      String
  fileName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Task {
  id                    String       @id @default(cuid())
  companyId             String
  projectId             String
  phaseId               String?
  title                 String
  description           String?      @db.Text
  priority              TaskPriority @default(MEDIUM)
  status                TaskStatus   @default(PENDING)
  plannedStart          DateTime?
  plannedEnd            DateTime?
  totalTimeSpentMinutes Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  company               Company      @relation(fields: [companyId], references: [id])
  project               Project      @relation(fields: [projectId], references: [id])
  phase                 ProjectPhase? @relation(fields: [phaseId], references: [id])
  assignees             TaskAssignment[]
  attachments           TaskAttachment[]
  depsFrom              TaskDependency[] @relation("DepFrom")
  depsTo                TaskDependency[] @relation("DepTo")
  timers                TimerSession[]
  incidents             Incident[]

  @@index([projectId, status])
  @@index([companyId])
}

model TaskAssignment {
  id        String   @id @default(cuid())
  companyId String
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  companyId String
  taskId    String
  path      String
  fileName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskDependency {
  id        String             @id @default(cuid())
  companyId String
  fromId    String
  toId      String
  type      TaskDependencyType @default(FS)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  company   Company            @relation(fields: [companyId], references: [id])
  from      Task               @relation("DepFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Task               @relation("DepTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

model TimerSession {
  id                 String               @id @default(cuid())
  companyId          String
  userId             String
  taskId             String
  startedAt          DateTime
  closedAt           DateTime?
  pausedAt           DateTime?
  pauseAccumMinutes  Int                  @default(0)
  durationMinutes    Int?
  lat                Decimal?             @db.Decimal(10, 7)
  lng                Decimal?             @db.Decimal(10, 7)
  machineId          String?
  localId            String?
  deviceId           String?
  isSynced           Boolean              @default(true)
  approvalStatus     TimerApprovalStatus  @default(APPROVED)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  company            Company              @relation(fields: [companyId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
  task               Task                 @relation(fields: [taskId], references: [id])
  machine            Machine?             @relation(fields: [machineId], references: [id])

  @@index([companyId, userId])
  @@index([taskId])
  @@index([machineId])
  @@unique([companyId, userId, deviceId, localId])
}

model QuantityItem {
  id          String        @id @default(cuid())
  companyId   String
  projectId   String
  phaseId     String?
  name        String
  unit        QuantityUnit
  plannedQty  Decimal       @db.Decimal(12, 3)
  executedQty Decimal       @default(0) @db.Decimal(12, 3)
  note        String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  company     Company       @relation(fields: [companyId], references: [id])
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase       ProjectPhase? @relation(fields: [phaseId], references: [id])

  @@index([projectId])
}

model Amendment {
  id         String               @id @default(cuid())
  companyId  String
  entityType AmendmentEntityType
  entityId   String
  field      String
  oldValue   String               @db.Text
  newValue   String               @db.Text
  reason     String               @db.Text
  actorId    String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  company    Company              @relation(fields: [companyId], references: [id])
  actor      User                 @relation(fields: [actorId], references: [id])

  @@index([companyId, entityType, entityId])
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  OPEN
  ACK
  CLOSED
}

model DiaryEntry {
  id              String   @id @default(cuid())
  companyId       String
  projectId       String
  date            DateTime @db.Date
  weather         String?
  tempMin         Decimal? @db.Decimal(4, 1)
  tempMax         Decimal? @db.Decimal(4, 1)
  workDescription String?  @db.Text
  problemsNoted   String?  @db.Text
  workersCount    Int?
  pdfUrl          String?
  isVoiceInput    Boolean  @default(false)
  isSynced        Boolean  @default(true)
  localId         String?
  deviceId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id])
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photos          DiaryPhoto[]

  @@unique([companyId, projectId, date])
  @@unique([companyId, deviceId, localId])
  @@index([projectId])
}

model DiaryPhoto {
  id           String   @id @default(cuid())
  companyId    String
  diaryEntryId String
  path         String
  caption      String?
  lat          Decimal? @db.Decimal(10, 7)
  lng          Decimal? @db.Decimal(10, 7)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id])
  diaryEntry   DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)

  @@index([diaryEntryId])
}

model Incident {
  id          String           @id @default(cuid())
  companyId   String
  projectId   String?
  taskId      String?
  userId      String
  severity    IncidentSeverity
  description String           @db.Text
  lat         Decimal?         @db.Decimal(10, 7)
  lng         Decimal?         @db.Decimal(10, 7)
  status      IncidentStatus   @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id])
  project     Project?         @relation(fields: [projectId], references: [id])
  task        Task?            @relation(fields: [taskId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  photos      IncidentPhoto[]

  @@index([companyId, status])
  @@index([projectId])
}

model IncidentPhoto {
  id         String   @id @default(cuid())
  companyId  String
  incidentId String
  path       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id])
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}
