enum PartnerType {
  CLIENT
  SUPPLIER
}

enum CostCategory {
  FUEL
  SERVICE
  MATERIAL
  LABOR
  OTHER
}

enum CostSource {
  MANUAL
  FUEL
  SERVICE
  PAYROLL
}

enum WarehouseType {
  SITE
  YARD
  CISTERN
}

model Partner {
  id        String      @id @default(cuid())
  companyId String
  type      PartnerType
  name      String
  taxId     String?
  note      String?     @db.Text
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  company   Company     @relation(fields: [companyId], references: [id])
  projects  Project[]

  @@index([companyId, type])
  @@index([taxId])
}

model CostEntry {
  id        String       @id @default(cuid())
  companyId String
  amount    Decimal      @db.Decimal(12, 2)
  category  CostCategory
  date      DateTime
  note      String?      @db.Text
  source    CostSource
  sourceId  String?
  projectId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  company   Company      @relation(fields: [companyId], references: [id])
  project   Project?     @relation(fields: [projectId], references: [id])

  @@unique([companyId, source, sourceId])
  @@index([companyId, projectId])
  @@index([sourceId])
  @@index([projectId])
}

model Warehouse {
  id        String        @id @default(cuid())
  companyId String
  name      String
  type      WarehouseType
  projectId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  company   Company       @relation(fields: [companyId], references: [id])
  project   Project?      @relation(fields: [projectId], references: [id])
  movements StockMovement[]

  @@index([companyId, type])
  @@index([projectId])
}

model StockMovement {
  id          String    @id @default(cuid())
  companyId   String
  warehouseId String
  materialId  String
  qty         Decimal   @db.Decimal(12, 3)
  projectId   String?
  fuelEntryId String?   @unique
  idempotencyKey String?
  requestFingerprint String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  material    Material  @relation(fields: [materialId], references: [id])
  project     Project?  @relation(fields: [projectId], references: [id])
  fuelEntry   FuelEntry? @relation(fields: [fuelEntryId], references: [id])

  @@unique([companyId, idempotencyKey])
  @@index([companyId, warehouseId, materialId])
  @@index([warehouseId])
  @@index([materialId])
  @@index([projectId])
  @@index([fuelEntryId])
}
