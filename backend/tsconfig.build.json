{
  // `prisma/` je NAMJERNO uključen u build: seed (prisma/seed.ts) se kompajlira
  // u `dist/prisma/seed.js`, pa se u produkcijskoj slici može pokrenuti sa
  // `node dist/prisma/seed.js` (bez `tsx`, bez TypeScript izvora i bez dev
  // zavisnosti). Vidi docs/INFRASTRUCTURE.md §6.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "."
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "generated",
    "prisma.config.ts",
    "**/*spec.ts"
  ]
}
